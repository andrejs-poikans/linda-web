---
const { lang, title } = Astro.props;
import "../assets/css/style.css";
import "../assets/css/reset.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const name = "Linda Mence";
const defaultLang = "lv";

const bio_eng =
  "I’m a poet writing for adults and children, I do a lot of drawing, translate poetry and prose from English to Latvian and work as an editor in “Punctum” literary magazine. I’m currently based in Riga and Brussels.";
const bio_lv =
  "Es esmu dzejniece, es rakstu pieaugušajiem un bērniem, daudz zīmēju un reizēm ilustrēju, tulkoju dzeju un prozu no angļu uz latviešu valodu un esmu redaktore žurnālā “Punctum”. Dzīvoju Rīgā un Briselē.";

// fonts
// eb garamond
import "@fontsource-variable/eb-garamond/wght.css";
import "@fontsource-variable/eb-garamond/wght-italic.css";
---

<!doctype html>
<html lang={lang ? lang : defaultLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title !== "index" ? `${title}` : name}</title>
    <meta name="meta-title" content={title !== "index" ? `${title}` : name} />
    <!-- <meta name="description" content={title !== "index" ? `${title}` : name} /> -->
    <meta name="description" content={lang === "lv" ? bio_lv : bio_eng} />
    <link
      rel="canonical"
      href={`https://lindamence.com${Astro.url.pathname}`}
    />

    <meta property="og:title" content={title !== "index" ? `${title}` : name} />
    <meta
      property="og:description"
      content={lang === "lv" ? bio_lv : bio_eng}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`https://lindamence.com${Astro.url.pathname}`}
    />

    <!-- favicon placement -->
    <link
      rel="icon"
      type="image/png"
      href="/favicon/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Linda Mence" />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/FD_Garamondt/Garamondt-Italic.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/FD_Garamondt/Garamondt-Regular.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
  </head>
  <body>
    <Header lang={lang ? lang : defaultLang} />
    <!-- slot -->
    <slot />
    <Footer lang={lang ? lang : defaultLang} />

    <div class="canvas"></div>
  </body>
</html>
