---
import { Masonry } from 'astro-masonry';
import Layout from "../layouts/Layout.astro";
import Picture from 'astro/components/Picture.astro';
import Gallery from '../components/Gallery.jsx';
const { frontmatter } = Astro.props;
const galleryItems = frontmatter.gallery?.filter((item: any) => item?.image) ?? [];

const slotContent = await Astro.slots.render('default');
const hasBodyText = slotContent.trim().length > 0;

---

<Layout title={frontmatter.sectionTitle ? `${frontmatter.sectionTitle}: ${frontmatter.title}` : `${frontmatter.title}`} lang={frontmatter.lang}>

  <main>

    <div class="poster-md">
     <!-- md body mandatory -->
    { hasBodyText && (
    <div class="md-container"> 
          { frontmatter.title !== "index" && (
          <div class="path">
            {
              frontmatter.sectionTitle && (
                <div class="sectiontitle">
                  <h1>{frontmatter.sectionTitle}</h1>
                </div>
                <span class="seperator">></span>
              )
            }
            <div class="pagetitle">
              <h1>{frontmatter.title}</h1>
            </div>
            </div>
            )}
        <div class="md-body">
            <slot />
        </div>
        <script type="module" >
          document.querySelectorAll('.md-body a').forEach((anchor) => {
            anchor.setAttribute('target', '_blank');
            anchor.setAttribute('rel', 'noopener noreferrer');
          });
        </script>
    </div>
    )}

    {
    galleryItems.length > 0 && 
      (
        <>
            {[galleryItems[0]].map((item: any, index: number) => (
              <div class = "img-wrap first-img">
              <button
                type="button"
                class="gallery-thumb"
                data-gallery-id="page-gallery"
                data-gallery-index={index}
                aria-label={`Open image ${index + 1} of ${galleryItems.length}`}
              >
                <Picture
                  src={item.image}
                  alt={item.alt || ""}
                  format="webp"
                  layout="constrained"
                  fallbackFormat="jpg"
                  quality={80}
                  loading="lazy"
                  inferSize={true}
                  decoding="async"
                  sizes="(max-width: 700px) 100vw, 33vw"
                />                         
              </button>
              {item.alt && <span class="img-alt-text">{item.alt}</span>}
              </div>
            ))}

          <Gallery
            items={galleryItems}
            galleryId="page-gallery"
            client:load
          />
        </>
      )
    }
    </div>

    {galleryItems.length > 0 && (
      <div id="masonry-loading" class="gallery-loading" aria-live="polite" aria-label="Loading gallery">
        <div class="gallery-loading__spinner"></div>
      </div>
    )}

    <div id="masonry-wrapper" class="gallery-masonry-shell is-loading" aria-hidden="true">
      <Masonry
        breakpointCols={{
          default: 3,
          500: 1,
        }}
        debug= {false}
            >

           <!-- build gallery if it exists -->
          {
            galleryItems.length > 0 && (
                <>
                    {galleryItems.slice(1).map((item: any, index: number) => (
                      <div class = "img-wrap">
                      <button
                        type="button"
                        class="gallery-thumb"
                        data-gallery-id="page-gallery"
                        data-gallery-index={index + 1}
                        aria-label={`Open image ${index + 1} of ${galleryItems.length}`}
                      >
                        <Picture
                          src={item.image}
                          alt={item.alt || ""}
                          format="webp"
                          layout="constrained"
                          fallbackFormat="jpg"
                          quality={80}
                          loading={index < 3 ? "eager" : "lazy"}
                          inferSize={true}
                          decoding="async"
                          sizes="(max-width: 700px) 100vw, 33vw"
                        />                         
                      </button>
                      {item.alt && <span class="img-alt-text">{item.alt}</span>}
                      </div>
                    ))}
                </>
            )
          }
      </Masonry>
    </div>

    <script type="module">
      const loader = document.getElementById('masonry-loading');
      const masonryWrapper = document.getElementById('masonry-wrapper');

      if (loader && masonryWrapper && loader.dataset.loaded !== 'true') {
        const revealMasonry = () => {
          window.requestAnimationFrame(() => {
            window.setTimeout(() => {
              loader.classList.add('is-hidden');
              masonryWrapper.classList.remove('is-loading');
              masonryWrapper.classList.add('is-ready');
              masonryWrapper.setAttribute('aria-hidden', 'false');
              loader.dataset.loaded = 'true';
            }, 120);
          });
        };

        if (document.readyState === 'complete') {
          revealMasonry();
        } else {
          window.addEventListener('load', revealMasonry, { once: true });
        }
      }
    </script>
  </main>
</Layout>
